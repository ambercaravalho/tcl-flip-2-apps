<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amber.tcltweaks">

    <application
        android:label="TCL Tweaks"
        android:allowBackup="false">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposeddescription"
            android:value="Small fixes for TCL's own apps. Settings and the browser (Chromium): stay in light mode while the rest of the phone uses dark mode (their dark mode is only half done). System UI: no more &quot;Battery is fully charged&quot; notification; low-battery warnings still show." />
        <meta-data
            android:name="xposedscope"
            android:value="com.android.settings;com.android.systemui;org.chromium.chrome" />
    </application>
</manifest>
