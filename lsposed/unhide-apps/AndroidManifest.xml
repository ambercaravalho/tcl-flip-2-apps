<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amber.dumbdownunhide">

    <application
        android:label="DumbDown App Visibility"
        android:allowBackup="false">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposeddescription"
            android:value="Unhides Magisk and Chrome in DumbDown Launcher by removing them from its hardcoded app denylist, and hides tiles you don't use: dumb keys, 2-factor auth, device setup, quack, rideshare, signal, smart cal, free up space and smart txt." />
        <meta-data
            android:name="xposedscope"
            android:value="com.offlineinc.dumbdownlauncher" />
    </application>
</manifest>
