<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.amber.settingslight">

    <application
        android:label="Settings Light Mode"
        android:allowBackup="false">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposeddescription"
            android:value="Keeps TCL's Settings app in light mode while the rest of the phone uses dark mode. Its dark mode is only half done (black text on dark backgrounds), so this tells the app's resources it isn't night mode." />
        <meta-data
            android:name="xposedscope"
            android:value="com.android.settings" />
    </application>
</manifest>
